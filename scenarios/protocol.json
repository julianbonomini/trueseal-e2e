{
  "$schema": "Scenario Driver control protocol (docs/scenario-driver-protocol.md) — the machine-readable vocabularies",
  "comment": "Protocol Version 1 == the Kotlin reference driver's contract (KOTLIN-2 v0 draft, promoted). errorCodes MUST equal the pinned core's docs/shared-facts.json `errors` list — gate runs check this and fail on drift (G12 discipline). `driver` and `malformed` are driver-local codes, never SDK errors.",
  "version": 1,
  "errorCodes": [
    "invalidRelayAddress",
    "invalidNamespace",
    "storage",
    "closed",
    "notMember",
    "alreadyInGroup",
    "invalidPairingToken",
    "pairingClosed",
    "groupFull",
    "memberNotFound",
    "payloadTooLarge",
    "messageHandlerAlreadySet",
    "storeTooNew",
    "manifestVersionExhausted"
  ],
  "driverErrorCodes": ["driver", "malformed"],
  "commands": [
    "open",
    "close",
    "info",
    "send",
    "startPairing",
    "accept",
    "cancelPairing",
    "join",
    "cancelJoin",
    "remove",
    "leave",
    "destroyGroup",
    "status",
    "me",
    "members",
    "connection",
    "receive",
    "listenEvents",
    "listenIssues"
  ],
  "eventKinds": ["statusChanged", "membersChanged", "joinRequest", "connectionChanged", "admissionDropped"],
  "issueKinds": ["unreadable", "unauthorized", "heldForUpgrade", "handlerGaveUp", "sendFailed"],
  "statuses": ["notJoined", "pendingJoin", "member", "leaving", "destroying"],
  "statusReasons": ["created", "joined", "left", "removed", "destroyed", "storeReset"],
  "connectionStates": ["connecting", "connected", "disconnected", "relayVersionUnsupported"],
  "unreadableReasons": ["malformed", "senderOutdated", "expired", "droppedWhileHeld"],
  "sendFailedReasons": ["tooLarge", "malformed", "expired"],
  "admissionDropReasons": ["groupFull"]
}
